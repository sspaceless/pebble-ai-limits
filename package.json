{
  "name": "pebble-codex-usage",
  "version": "0.1.0",
  "author": "Illia",
  "description": "Subscription usage and API quota caps for AI providers on Pebble",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "scripts": {
    "generate:icons": "node tools/generate-provider-icons.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:direct": "node tools/check-direct.mjs",
    "check:gemini": "node tools/check-gemini.mjs",
    "lint:js": "eslint . --max-warnings 0",
    "lint:c": ".venv/bin/cpplint --recursive src/c",
    "lint": "npm run lint:js && npm run lint:c && npm run format:check",
    "format:js": "npm run lint:js:fix && prettier --write \"src/pkjs/**/*.js\" \"tools/*.mjs\" \"tests/*.mjs\" \"*.mjs\" \"*.json\"",
    "format": "npm run format:js && node tools/format-c.mjs --write",
    "format:check": "prettier --check \"src/pkjs/**/*.js\" \"tools/*.mjs\" \"tests/*.mjs\" \"*.mjs\" \"*.json\" && node tools/format-c.mjs",
    "check": "npm run lint && npm test",
    "lint:js:fix": "eslint . --fix --max-warnings 0",
    "prepare": "husky",
    "generate:previews:phone": "node tools/generate-phone-previews.mjs",
    "package:release": ".venv/bin/python tools/package-release.py"
  },
  "pebble": {
    "displayName": "AI Limits",
    "uuid": "c8dca1a8-6d05-4c0e-a85a-f2f8a3457468",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": {
      "REQUEST": 0,
      "P_LEFT": 1,
      "P_RESET": 2,
      "S_LEFT": 4,
      "S_RESET": 5,
      "UPDATED": 7,
      "STATUS": 8,
      "PROVIDER": 9,
      "PROVIDER_NAME": 10,
      "P_VALUE": 11,
      "S_VALUE": 12,
      "P_NOTE": 13,
      "S_NOTE": 14,
      "NAV": 15,
      "ACCOUNT_ID": 16,
      "ACCOUNT_NAME": 17,
      "ACCOUNT_REV": 18,
      "UPDATING": 21,
      "ACCOUNT_COUNT": 22
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
